diff -ruN a/docker/Caddyfile b/docker/Caddyfile
--- a/docker/Caddyfile	2026-10-25 19:02:06.846170421 -0300
+++ b/docker/Caddyfile	2026-10-25 19:02:06.860944056 -0300
@@ -1,5 +1,11 @@
 # Site da Central WhatsApp. O Caddy pede e renova sozinho o certificado HTTPS (Let's Encrypt)
 # para o domínio definido em DOMINIO no arquivo .env.
+#
+# Este Caddy também atende outros sistemas do mesmo Droplet (ex.: softIA): os trechos deles ficam em
+# /etc/caddy/extra (pasta /opt/caddy-extra no servidor). Sem arquivos lá, nada muda.
+{
+	import /etc/caddy/extra/*.global
+}
 {$DOMINIO} {
 	encode zstd gzip
 	root * /srv
@@ -22,3 +28,6 @@
 	@demais not path /assets/*
 	header @demais Cache-Control "no-cache"
 }
+
+# Sites de outros sistemas do Droplet (ex.: softIA)
+import /etc/caddy/extra/*.site
diff -ruN a/docker-compose.yml b/docker-compose.yml
--- a/docker-compose.yml	2026-10-25 19:02:06.847553902 -0300
+++ b/docker-compose.yml	2026-10-25 19:02:06.861112525 -0300
@@ -36,6 +36,8 @@
     volumes:
       - caddy_dados:/data
       - caddy_config:/config
+      # Trechos de Caddy de outros sistemas do Droplet (ex.: softIA). Pasta vazia = sem efeito.
+      - /opt/caddy-extra:/etc/caddy/extra:ro
     logging:
       driver: json-file
       options: { max-size: "10m", max-file: "3" }
