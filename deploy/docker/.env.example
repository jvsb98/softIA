# =====================================================================
#  softIA — variáveis do servidor (copie para .env e preencha)
# =====================================================================

# --- Endereços
# Clientes ficam em <slug>.BASE_DOMAIN; o painel do fornecedor em PLATFORM_HOST (padrão: painel.BASE_DOMAIN)
BASE_DOMAIN=connectawork.app.br
PUBLIC_URL=https://painel.connectawork.app.br
# PLATFORM_HOST=painel.connectawork.app.br
# Nome do produto no painel do fornecedor (os clientes veem a marca de cada um)
# PLATFORM_BRAND_NAME=softIA

# --- Banco (Supabase: Project Settings → Database → Connection string → "Session pooler")
# Use SEMPRE o pooler em modo SESSÃO (porta 5432). O modo transação (6543) não funciona com o softIA.
NIMBER_DB_HOST=aws-0-sa-east-1.pooler.supabase.com
NIMBER_DB_PORT=5432
NIMBER_DB_NAME=postgres
NIMBER_DB_USER=postgres.<id-do-projeto>
NIMBER_DB_PASSWORD=
# Supabase exige TLS; "no-verify" aceita o certificado sem baixar o CA (true + NIMBER_DB_SSL_CA para validar)
NIMBER_DB_SSL=no-verify
NIMBER_DB_POOL_MAX=10

# --- Chave-mestra (cifra segredos no banco). Gere uma vez e GUARDE em local seguro:
#   openssl rand -base64 32
# Sem ela, os segredos já gravados (2FA, chaves de IA) não podem ser lidos.
NIMBER_MASTER_KEY=

# --- Imagem (GitHub Container Registry) e limites
SOFTIA_IMAGE=ghcr.io/jvsb98/softia:main
SOFTIA_MEM_LIMIT=900m
SOFTIA_HEAP_MB=512
# Rede Docker do Caddy que já atende 80/443 (Central WhatsApp)
EDGE_NETWORK=central-whatsapp_default
