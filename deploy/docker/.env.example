# =====================================================================
#  Nimber Atende — variáveis do Docker Compose
#  Copie para .env (cp .env.example .env) e preencha. NUNCA suba o .env para o GitHub.
# =====================================================================

# Domínio público (o DNS deve apontar para o IP do Droplet)
DOMAIN=atende.nimber.com.br
PUBLIC_URL=https://atende.nimber.com.br

# Imagem publicada pelo GitHub Actions (troque "nimber" pelo dono do repositório no GitHub)
NIMBER_IMAGE=ghcr.io/nimber/nimber-atende:latest

# ---- Banco de dados ----------------------------------------------------
# Opção A — PostgreSQL gerenciado da DigitalOcean (recomendado):
#   copie host/porta/usuário/senha do painel (Databases → Connection details)
#   e cole o conteúdo do "CA certificate" em NIMBER_DB_SSL_CA (uma linha, com \n)
#   ou grave o arquivo no volume /config e use NIMBER_DB_SSL_CA=ca-certificate.crt
# NIMBER_DB_HOST=db-postgresql-nyc3-00000-do-user-0000000-0.b.db.ondigitalocean.com
# NIMBER_DB_PORT=25060
# NIMBER_DB_NAME=nimber_atende
# NIMBER_DB_USER=nimber_atende
# NIMBER_DB_SSL=true
#
# Opção B — PostgreSQL no próprio Droplet (perfil local-db): deixe HOST em branco
NIMBER_DB_NAME=nimber_atende
NIMBER_DB_USER=nimber_atende
NIMBER_DB_PASSWORD=troque-por-uma-senha-longa

# ---- Chave mestra -------------------------------------------------------
# Cifra as chaves de IA, senhas de bancos externos e segredos de 2FA.
# Vindo do servidor Windows: rode "nimber-cli export-key" lá e cole aqui.
# Em branco: é gerada na primeira execução e guardada no volume /config.
NIMBER_MASTER_KEY=

TRUST_PROXY=true
LOG_LEVEL=info
