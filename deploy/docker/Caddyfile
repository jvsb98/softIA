# HTTPS automático (Let's Encrypt) na frente do Nimber Atende.
# O domínio vem da variável DOMAIN do .env; o DNS precisa apontar para o Droplet antes de subir.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# WebSocket (Socket.IO) é repassado automaticamente
	reverse_proxy app:8080 {
		header_up X-Real-IP {remote_host}
	}

	log {
		output stdout
		format console
	}
}
